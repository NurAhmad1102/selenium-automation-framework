<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30" packages="org.example.utils">
    <Properties>
        <Property name="logPath">${sys:user.dir}/logs</Property>
        <Property name="rollingFileName">automation-test</Property>
        <Property name="consolePattern">%highlight{[%-5level]}{FATAL=bg_red, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan} %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %X{testMethod:-unknown} %c{1.}.%M() - %msg%n%throwable{short.lineNumber}</Property>
        <Property name="filePattern">[%-5level] %d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %X{testMethod:-unknown} %c{1.}.%M() - %msg%n%throwable{full}</Property>
    </Properties>

    <Appenders>
        <Console name="console" target="SYSTEM_OUT" immediateFlush="true">
            <PatternLayout pattern="${consolePattern}" />
        </Console>

        <RollingFile name="rollingFile" fileName="${logPath}/${rollingFileName}.log" filePattern="${logPath}/${rollingFileName}_%d{yyyy-MM-dd}_%i.log" immediateFlush="true">
            <PatternLayout pattern="${filePattern}" />
            <Policies>
                <OnStartupTriggeringPolicy />
                <TimeBasedTriggeringPolicy interval="1" modulate="true" />
                <SizeBasedTriggeringPolicy size="10 MB" />
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${logPath}" maxDepth="1">
                    <IfFileName glob="${rollingFileName}_*.log" />
                    <IfLastModified age="30d" />
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <ExtentReportAppender name="extent">
            <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="%msg%n" />
        </ExtentReportAppender>
    </Appenders>

    <Loggers>
        <Logger name="org.example" level="DEBUG" additivity="false">
            <AppenderRef ref="console" />
            <AppenderRef ref="rollingFile" />
            <AppenderRef ref="extent" />
        </Logger>

        <Logger name="org.openqa.selenium" level="WARN" additivity="false">
            <AppenderRef ref="console" />
            <AppenderRef ref="rollingFile" />
            <AppenderRef ref="extent" />
        </Logger>

        <Logger name="org.apache" level="WARN" additivity="false">
            <AppenderRef ref="console" />
            <AppenderRef ref="rollingFile" />
        </Logger>

        <Root level="INFO" additivity="false">
            <AppenderRef ref="console" />
            <AppenderRef ref="rollingFile" />
            <AppenderRef ref="extent" />
        </Root>
    </Loggers>
</Configuration>
