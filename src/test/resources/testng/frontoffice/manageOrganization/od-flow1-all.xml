<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="FrontOffice - Update Organization Suite" parallel="classes" thread-count="3">
    <listeners>
        <listener class-name="org.example.listener.Listeners"/>
    </listeners>

    <test name="Architecture Rules">
        <classes>
            <class name="org.example.ArchitectureTest"/>
        </classes>
    </test>

    <test verbose="2" name="Manage Organization - Flow 1: Update Organization All Test">
        <classes>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.UpdateOrganizationFilterTest"/>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.setOrganization.AddOrganizationTest"/>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.setOrganization.RemoveOrganizationTest"/>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.setOrganization.MergeOrganizationTest"/>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.setOrganization.RenameOrganizationTest"/>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.setOrganization.SplitOrganizationTest"/>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.setOrganization.MoveOrganizationTest"/>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.setOrganization.MultiActionOrganizationTest"/>
        </classes>
    </test>
</suite>
