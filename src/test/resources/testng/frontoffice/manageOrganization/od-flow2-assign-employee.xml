<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="FrontOffice - Assign Employee Suite" parallel="false">
    <listeners>
        <listener class-name="org.example.listener.Listeners"/>
    </listeners>

    <test name="Architecture Rules">
        <classes>
            <class name="org.example.ArchitectureTest"/>
        </classes>
    </test>

    <test verbose="2" name="My Organization - Assign Employee Test">
        <classes>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.assignEmployee.AddIncumbentTest"/>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.assignEmployee.MoveIncumbentTest"/>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.assignEmployee.RemoveIncumbentTest"/>
        </classes>
    </test>
</suite>
