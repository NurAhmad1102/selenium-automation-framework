<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="FrontOffice - Multi Action Organization Suite" parallel="false">
    <listeners>
        <listener class-name="org.example.listener.Listeners"/>
    </listeners>
    <test name="Architecture Rules">
        <classes>
            <class name="org.example.ArchitectureTest"/>
        </classes>
    </test>

    <test verbose="2" name="My Organization - Multi Action Sequential Tests">
        <classes>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.setOrganization.MultiActionOrganizationTest">
                <methods>
                    <include name="movePrimaryAndSplitChildTest"/>
                    <include name="movePrimaryAndMergeChildTest"/>
                    <include name="movePrimaryAndRenameChildTest"/>
                    <include name="renamePrimaryAndMergeChildTest"/>
                    <include name="renamePrimaryAndSplitChildTest"/>
                    <include name="splitPrimaryAndSplitChildTest"/>
                    <include name="splitPrimaryAndRenameChildTest"/>
                    <include name="splitPrimaryAndMergeChildTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
