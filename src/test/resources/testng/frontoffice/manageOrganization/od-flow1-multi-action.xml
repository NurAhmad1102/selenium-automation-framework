    <test verbose="2" name="My Organization - Multi Action Sequential Tests">
        <classes>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.setOrganization.MultiActionOrganizationTest"/>
        </classes>
    </test>
</suite>
