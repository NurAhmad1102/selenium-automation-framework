<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="FrontOffice - OD Flow 3 Organization Changes Justification Suite" parallel="false" thread-count="1">
    <listeners>
        <listener class-name="org.example.listener.Listeners"/>
    </listeners>

    <test name="Architecture Rules">
        <classes>
            <class name="org.example.ArchitectureTest"/>
        </classes>
    </test>

    <test verbose="2" name="Manage Organization - Validate Flow 3: Organization Changes Justification Test">
        <classes>
            <class name="org.example.test.frontoffice.myOrganization.manageOrganization.organizationChangesJustification.OrganizationChangesJustificationTest">
                <methods>
                    <include name="validateRenameOrganizationJustificationTest"/>
                    <include name="validateSplitOrganizationJustificationTest"/>
                    <include name="validateAddOrganizationJustificationTest"/>
                    <include name="validateMoveOrganizationJustificationTest"/>
                    <include name="validateMergeOrganizationJustificationTest"/>
                    <include name="validateRemoveOrganizationJustificationTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
