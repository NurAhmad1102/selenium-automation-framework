<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="BackOffice - SLA Setting Suite" parallel="classes" thread-count="3">
    <listeners>
        <listener class-name="org.example.listener.Listeners"/>
    </listeners>

    <test name="Architecture Rules">
        <classes>
            <class name="org.example.ArchitectureTest"/>
        </classes>
    </test>
    <test verbose="2" name="SLA Setting">
        <classes>
            <class name="org.example.test.backoffice.manageOrganization.slaSetting.AddSlaSettingTest"/>
            <class name="org.example.test.backoffice.manageOrganization.slaSetting.EditSlaSettingTest"/>
            <class name="org.example.test.backoffice.manageOrganization.slaSetting.SlaSettingTest"/>
            <class name="org.example.test.backoffice.manageOrganization.slaSetting.SlaDetailTest"/>
        </classes>
    </test>
</suite>
